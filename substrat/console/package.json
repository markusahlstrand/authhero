{
  "name": "authhero-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AuthHero control-plane vertical on Substrat — tenant registry + entitlements seam (design: billing-and-console-on-substrat.md, Stage 2)",
  "substrat": {
    "slug": "authhero-console",
    "name": "AuthHero Console",
    "tenant": "authhero-mqk5x7",
    "permissions": "src/permissions.ts",
    "envSpec": [
      {
        "key": "OIDC_ISSUER",
        "label": "AuthHero issuer",
        "description": "The AuthHero deployment console admins log in against — byte-exact as it appears in the iss claim (usually ends with /).",
        "placeholder": "https://auth.example.com/",
        "required": true,
        "group": "Auth",
        "default": "https://authhero-auth-core-authhero.global.substrat.run/"
      },
      {
        "key": "OIDC_CLIENT_ID",
        "label": "Console client id",
        "description": "The AuthHero client the SPA uses for PKCE login.",
        "default": "default",
        "group": "Auth"
      },
      {
        "key": "OIDC_AUDIENCE",
        "label": "API audience",
        "description": "The audience bearer tokens must carry. urn:authhero:management matches the admin surface and always exists on seeded tenants.",
        "required": false,
        "group": "Auth",
        "default": "urn:authhero:management"
      },
      {
        "key": "OWNER_SUB",
        "label": "Operator sub",
        "description": "The AuthHero sub of the human operator; grants their login the platform-operator role at provision/reconcile.",
        "required": false,
        "group": "Bootstrap",
        "default": "auth0|0aceaa2aa48fddc1729072ee"
      }
    ]
  },
  "scripts": {
    "server": "tsx src/server.ts",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "gen:assets": "node scripts/gen-assets.mjs",
    "app:build": "npm --prefix app run build",
    "pretypecheck": "node scripts/gen-assets.mjs",
    "typecheck": "tsc --noEmit",
    "pretypecheck:worker": "node scripts/gen-assets.mjs",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "prebuild:worker": "node scripts/gen-assets.mjs",
    "build:worker": "tsc -p tsconfig.worker.json",
    "lint:boundaries": "boundary-lint",
    "verify": "npm run typecheck && npm run typecheck:worker && npm test && npm run lint:boundaries",
    "platform:local": "tsx scripts/local-platform.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@substrat-run/adapter-cloudflare": "^0.35.0",
    "@substrat-run/adapter-sqlite": "^0.35.0",
    "@substrat-run/contracts": "^0.35.0",
    "@substrat-run/control-plane-api": "^0.35.0",
    "@substrat-run/kernel": "^0.35.0",
    "better-sqlite3": "^11.0.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@substrat-run/boundary-lint": "^0.0.5",
    "@types/node": "^22",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.30.0"
  }
}
