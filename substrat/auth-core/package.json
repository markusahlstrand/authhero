{
  "name": "authhero-substrat-auth-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The REAL AuthHero auth core as a Substrat vertical (design stage 1): the authhero package served per tenant over a PLATFORM-MINTED per-tenant relational store (tenantStores/#301 — D1 hosted, .sqlite locally). Succeeds substrat/authcore (the stand-in).",
  "substrat": {
    "slug": "authhero-auth-core",
    "name": "AuthHero Auth Core",
    "runtimeNeeds": {
      "entry": "dist/worker/worker.js",
      "needsNodeCompat": true,
      "build": "npm run build:worker",
      "stores": [
        {
          "binding": "SCOPE",
          "class": "ScopeDO"
        }
      ],
      "tenantStores": [
        {
          "binding": "AUTH_DB"
        }
      ]
    }
  },
  "scripts": {
    "gen:migrations": "node scripts/gen-migrations.mjs",
    "server": "tsx src/server.ts",
    "pretypecheck": "node scripts/gen-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "pretypecheck:worker": "node scripts/gen-migrations.mjs",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "prebuild:worker": "node scripts/gen-migrations.mjs",
    "build:worker": "tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@authhero/drizzle": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "@substrat-run/adapter-cloudflare": "^0.31.0",
    "@substrat-run/adapter-sqlite": "^0.31.0",
    "@substrat-run/contracts": "^0.31.0",
    "@substrat-run/kernel": "^0.31.0",
    "authhero": "workspace:*",
    "better-sqlite3": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@authhero/adapter-interfaces": "workspace:*",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.30.0"
  }
}
